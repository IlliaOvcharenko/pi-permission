{
  "$schema": "./config.schema.json",
  "$comment": "Example overlay for either scope. See docs/configs.md; not loaded automatically.",
  "configVersion": 2,
  "defaultMode": "plan",
  "cycleOrder": ["plan", "approve", "build"],
  "permissionGroups": {
    "tests": {
      "tool-parser": {
        "bash": { "npm test": "allow" },
        "dangerous_tool": "deny"
      }
    }
  },
  "modes": {
    "build": {
      "permissionGroups": ["development", "tests"],
      "color": "#7aa2f7",
      "systemPromptAppend": "Keep changes focused on the requested task."
    }
  }
}
