{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-permission.local/config.schema.json",
  "title": "pi-permission v2 global or trusted project overlay",
  "$comment": "See docs/configs.md. Runtime validation also checks references, parser syntax, and resolved sandbox invariants.",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [{ "required": ["configVersion"] }, { "maxProperties": 0 }],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "configVersion": { "const": 2 },
    "defaultMode": { "enum": ["plan", "approve", "build"] },
    "cycleOrder": { "type": "array", "minItems": 1, "items": { "enum": ["plan", "approve", "build"] } },
    "permissionGroups": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!constructor$|prototype$)[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/group" }
    },
    "modes": {
      "type": "object",
      "propertyNames": { "enum": ["plan", "approve", "build", "yolo"] },
      "additionalProperties": { "$ref": "#/$defs/mode" }
    },
    "prompts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "removeLegacySections": { "type": "array", "items": { "enum": ["permission_mode", "permission_mode_docs", "permission_mode_steering"] } },
        "sections": {
          "type": "object", "propertyNames": { "pattern": "^pi_permission_[a-z][a-z0-9_]*$" },
          "properties": {
            "pi_permission_runtime": {
              "type": "object", "additionalProperties": false,
              "properties": { "source": { "const": "runtime" }, "when": { "const": "sandboxed" } }
            }
          },
          "additionalProperties": { "$ref": "#/$defs/promptSection" }
        }
      }
    }
  },
  "$defs": {
    "action": { "enum": ["allow", "ask", "deny"] },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" } },
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\$(?!\\{(?:home|agentDir|project|scratch)\\}))[^*?\\[\\]\\u0000-\\u001f\\u007f]+$" } },
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/action" },
        { "type": "object", "propertyNames": { "minLength": 1, "maxLength": 4096, "pattern": "^(?![0-9]+$)[^\\u0000-\\u001f\\u007f]+$" }, "additionalProperties": { "$ref": "#/$defs/action" } }
      ]
    },
    "parser": {
      "type": "object",
      "propertyNames": { "pattern": "^(?:\\*|(?!__proto__$|constructor$|prototype$)[a-zA-Z_][a-zA-Z0-9_.:-]*)$" },
      "properties": {
        "bash": { "$ref": "#/$defs/rule" },
        "read": { "$ref": "#/$defs/rule" }, "write": { "$ref": "#/$defs/rule" }, "edit": { "$ref": "#/$defs/rule" },
        "grep": { "$ref": "#/$defs/rule" }, "find": { "$ref": "#/$defs/rule" }, "ls": { "$ref": "#/$defs/rule" }
      },
      "additionalProperties": { "$ref": "#/$defs/action" }
    },
    "sandboxFilesystem": {
      "type": "object", "additionalProperties": false,
      "properties": { "writeRoots": { "$ref": "#/$defs/paths" }, "denyRead": { "$ref": "#/$defs/paths" }, "denyWrite": { "$ref": "#/$defs/paths" } }
    },
    "filesystem": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "readRoots": { "$ref": "#/$defs/paths" }, "externalRead": { "$ref": "#/$defs/action" },
        "writeRoots": { "$ref": "#/$defs/paths" }, "denyRead": { "$ref": "#/$defs/paths" }, "denyWrite": { "$ref": "#/$defs/paths" },
        "writeExtensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[a-zA-Z0-9]+$" } },
        "denyDirectoryNames": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^(?!\\.\\.?$)[^/\\\\*?\\u0000-\\u001f\\u007f]+$" } },
        "protectedWrite": { "$ref": "#/$defs/strings" }
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tool-parser": { "$ref": "#/$defs/parser" }, "skills": { "$ref": "#/$defs/rule" }, "filesystem": { "$ref": "#/$defs/filesystem" },
        "bash-sandbox": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }, "filesystem": { "$ref": "#/$defs/sandboxFilesystem" },
            "linux": { "type": "object", "additionalProperties": false, "properties": { "allowNestedUserNamespaces": { "type": "boolean" } } }
          }
        }
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "permissionGroups": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "color": { "anyOf": [{ "enum": ["muted", "mdLink", "accent", "error"] }, { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }] },
        "systemPrompt": { "type": "string" }, "systemPromptAppend": { "type": "string" }
      }
    },
    "promptSection": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source": { "enum": ["text", "mode"] },
        "when": { "oneOf": [{ "enum": ["sandboxed", "always", "never"] }, { "type": "array", "items": { "enum": ["plan", "approve", "build", "yolo"] } }] },
        "text": { "type": "string" }
      }
    }
  }
}
